{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://argusnet/contracts/evidence.schema.json",
  "title": "S1 evidence record (argusnet.evidence/v1)",
  "description": "Evidence the run captured for an objective. Its sufficiency is not evaluated and stays unavailable.",
  "allOf": [
    {
      "$ref": "common.schema.json#/definitions/envelope"
    },
    {
      "type": "object",
      "required": [
        "objective_id",
        "platform_id",
        "captured_at_s",
        "dwell_s",
        "sufficiency"
      ],
      "properties": {
        "contract": {
          "const": "argusnet.evidence/v1"
        },
        "objective_id": {
          "type": "string"
        },
        "platform_id": {
          "$ref": "common.schema.json#/definitions/maybe_string"
        },
        "captured_at_s": {
          "$ref": "common.schema.json#/definitions/maybe_number"
        },
        "dwell_s": {
          "$ref": "common.schema.json#/definitions/maybe_number"
        },
        "sufficiency": {
          "$ref": "common.schema.json#/definitions/maybe_string"
        }
      }
    }
  ]
}
