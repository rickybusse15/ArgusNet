{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://argusnet/contracts/reconstruction.schema.json",
  "title": "S1 reconstruction record (argusnet.reconstruction/v1)",
  "description": "A reconstruction product (surface, volume or point cloud) built from the run's captures.",
  "allOf": [
    {
      "$ref": "common.schema.json#/definitions/envelope"
    },
    {
      "type": "object",
      "required": [
        "product",
        "format",
        "content_hash"
      ],
      "properties": {
        "contract": {
          "const": "argusnet.reconstruction/v1"
        },
        "product": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "content_hash": {
          "$ref": "common.schema.json#/definitions/maybe_string"
        }
      }
    }
  ]
}
