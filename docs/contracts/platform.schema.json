{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://argusnet/contracts/platform.schema.json",
  "title": "S1 platform record (argusnet.platform/v1)",
  "description": "One platform and its sensor, as the replay records them.",
  "allOf": [
    {
      "$ref": "common.schema.json#/definitions/envelope"
    },
    {
      "type": "object",
      "required": [
        "platform_id",
        "mobile",
        "sensor_type",
        "max_range_m",
        "fov_half_angle_deg",
        "calibration_version",
        "firmware_version"
      ],
      "properties": {
        "contract": {
          "const": "argusnet.platform/v1"
        },
        "platform_id": {
          "type": "string"
        },
        "mobile": {
          "type": "boolean"
        },
        "sensor_type": {
          "$ref": "common.schema.json#/definitions/maybe_string"
        },
        "max_range_m": {
          "$ref": "common.schema.json#/definitions/maybe_number"
        },
        "fov_half_angle_deg": {
          "$ref": "common.schema.json#/definitions/maybe_number"
        },
        "calibration_version": {
          "$ref": "common.schema.json#/definitions/maybe_string"
        },
        "firmware_version": {
          "$ref": "common.schema.json#/definitions/maybe_string"
        }
      }
    }
  ]
}
