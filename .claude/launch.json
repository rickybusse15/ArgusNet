{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tracking-daemon",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "-p", "argusnet-server", "--bin", "argusnetd", "--", "serve", "--listen", "127.0.0.1:50051"],
      "port": 50051
    },
    {
      "name": "viewer",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "-p", "argusnet-viewer", "--", "--scene", "scene.smartscene"]
    },
    {
      "name": "viewer-live",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "-p", "argusnet-viewer", "--", "--scene", "scene.smartscene", "--live", "127.0.0.1:50051"],
      "port": 50051
    }
  ]
}
